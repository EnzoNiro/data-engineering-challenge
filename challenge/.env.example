# Copie para .env se quiser mudar algum valor (todos têm padrão no docker-compose.yml).
#
# Linux: descomente e use o seu UID para evitar problemas de permissão nas pastas montadas.
# AIRFLOW_UID=1000

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Data warehouse (PostgreSQL com as camadas raw / trusted / refined)
WAREHOUSE_DB=wecogno_dw
WAREHOUSE_USER=wecogno
WAREHOUSE_PASSWORD=wecogno
WAREHOUSE_HOST_PORT=5433

# Spark (modo local, dentro do container do Airflow)
SPARK_DRIVER_MEMORY=3g
SPARK_LOCAL_CORES=4
